{
  "UseChosenModelForRestOfPipeline": false,
  "OnlyDoWarmUp": false,
  // <= Consider this
  "EnableParallelFileUploads": false,
  "CreateLogFiles": true,
  "GenerateOffsetFiles": true,
  "LoadHistoryIntoSystemInstruction": true,
  "InlineHistoryImages": true,
  "HistoryBatchCount": 1,
  "MergeSystemInstructionAndFirstHistoryBatch": false,
  "MergeAllConsecutiveHistoryBatches": false,
  /*
  * Reference Files:
  */
  "DebugSendReferenceFile": true,
  "SendDummyFileDuringTranscription": false,
  "SendDummyFileWithEachWarmUpRound": true,
  "InlinePrecedingLecTexParts": true,
  // Removes LaTeX comments and hidden environments from the inlined context files (preamble says so)
  "StripCommentsFromReferenceContext": true,
  // Slims the inlined parts older than the one just before (ReferenceSlimming.OlderParts below).
  // Keeps late parts under the free tier's 250k tokens/minute limit (tested 2026-10-16).
  "SlimOlderReferenceParts": true,
  // What is removed, per kind of part. Labels inside removed blocks are kept; sectioning, content and
  // theorem-like environments are only touched if listed. Unclosed environments are left alone.
  // Old behaviour (2026-10-16): OlderParts = { "RemoveEnvironments": ["tikzpicture"], "EmptyEnvironments": ["speech"] }.
  "ReferenceSlimming": {
    "OlderParts": {
      "StripCommentsAndHidden": true,
      "RemoveEnvironments": [ "speech", "overview", "insight", "steps", "note", "student", "pause", "aiNote", "tikzpicture" ],
      "EmptyEnvironments": [],
      "RemoveCommands": [ "inlinemetanote" ],
      "MarkRemovedEnvironments": false
    },
    // The part directly before the current one: the current part continues it, so only comments/hidden go,
    // except the header lines the next part needs (lecturer, language, last words and board).
    "PrecedingPart": {
      "StripCommentsAndHidden": true,
      "KeepCommentPrefixes": [ "% Lecturer(s):", "% Speaker(s):", "% Primary Language:", "% Final words:", "% Final board:" ],
      "RemoveEnvironments": [],
      "EmptyEnvironments": [],
      "RemoveCommands": [],
      "MarkRemovedEnvironments": false
    }
  },
  "DebugHelloRoundtrip": false,
  "GenerateAudioFile": true,
  "GoIntoLatexRefinement": true,
  "NumberOfParts": "auto",
  "OverlapSeconds": 240,
  "GoogleVideoFps": 0.25,
  "UseGoogleSearch": false,
  "FfmpegPreset": "ultrafast",
  // Options: "ultrafast" (fastest, 2-4x speedup), "veryfast", "fast", "medium"
