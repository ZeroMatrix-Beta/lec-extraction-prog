<Project>

  <!-- Shared by the app and the test project. -->
  <PropertyGroup>
    <!-- Runs the IDE style rules that .editorconfig raises to warnings during `dotnet build` too,
         not only in the editor. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- The project rule is "0 warnings". CI (GitHub Actions sets CI=true) enforces it by failing the
       build; local builds only show the warnings, so a stray one never stops `lecx` from building.
       NuGet audit warnings stay warnings: a new advisory for a package should not turn every PR red. -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
